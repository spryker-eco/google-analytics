{
    "name": "spryker-eco/google-analytics",
    "type": "library",
    "description": "GoogleAnalytics module",
    "license": "proprietary",
    "require": {
        "google/analytics-data": "^0.22",
        "php": ">=8.3",
        "spryker/gui": "^5.0.0",
        "spryker/kernel": "^3.46.0",
        "spryker/locale": "^4.0.0",
        "spryker/store": "^1.28.0",
        "spryker/symfony": "^3.0.0",
        "spryker/util-text": "^1.1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "*",
        "spryker/code-sniffer": "*",
        "spryker/testify": "*"
    },
    "autoload": {
        "psr-4": {
            "SprykerEco\\": "src/SprykerEco/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerEcoTest\\": "tests/SprykerEcoTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s src/ tests/",
        "cs-fix": "phpcbf -p src/ tests/",
        "phpstan": "phpstan analyse -c phpstan.neon -l 8 src/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
