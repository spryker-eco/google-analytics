{
    "name": "spryker-eco/google-analytics",
    "type": "library",
    "description": "GoogleAnalytics module",
    "license": "proprietary",
    "require": {
        "google/analytics-data": "^0.22",
        "php": ">=8.3",
        "spryker/gui": "^5.0.0",
        "spryker/kernel": "*",
        "spryker/locale": "*",
        "spryker/store": "*",
        "spryker/symfony": "*",
        "spryker/util-text": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "*",
        "spryker/code-sniffer": "*",
        "spryker/testify": "*"
    },
    "autoload": {
        "psr-4": {
            "SprykerEco\\": "src/SprykerEco/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerEcoTest\\": "tests/SprykerEcoTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/",
        "phpstan": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
