{% extends model('component') %}

{% define config = {
    name: 'traceable-events-google-analytics',
    tag: 'traceable-events-google-analytics',
} %}

{% define data = {
    gtagId: null,
} %}

{% set shouldRender = data.gtagId is defined %}

{# The schema default is `true`; the fallback keeps the event on while the configuration schema is not synced yet. #}
{% set isSearchEventEnabled = configurationValue('integrations:google_analytics:product_events:search', true) is same as(true) %}

{% define attributes = {
    initial: shouldRender
        ? {
            appId: data.gtagId,
            store: app.store,
            locale: app.locale,
            events: {
                search: isSearchEventEnabled,
            },
        } | json_encode
        : {},
    'traceable-adapter': true,
    'data-gtag-script-src': "https://www.googletagmanager.com/gtag/js?id=#{data.gtagId}",
} %}

{% block component %}
    {% if shouldRender %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block body %}
    {% include molecule('script-loader') with {
        attributes: {
            'async': true,
            'src': attributes['data-gtag-script-src'],
        },
    } only %}
{% endblock %}
