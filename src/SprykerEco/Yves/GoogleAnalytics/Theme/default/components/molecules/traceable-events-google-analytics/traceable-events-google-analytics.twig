{% extends model('component') %}

{% define config = {
    name: 'traceable-events-google-analytics',
    tag: 'traceable-events-google-analytics',
} %}

{% define data = {
    gtagId: null,
} %}

{# Without a Measurement ID nothing is loaded or sent; `is defined` was also true for the empty setting. #}
{% set shouldRender = data.gtagId is not empty %}

{# Event settings are named `<event>_event_enabled`, e.g. `search_event_enabled`. #}
{% set eventSettingSuffix = '_event_enabled' %}

{# Maps every event setting to its on/off state by event name, e.g. { search: true }; other settings of the tab never reach the page. #}
{% set enabledEvents = {} %}
{% for settingKey, settingValue in configurationValues('integrations:google_analytics') %}
    {% set settingName = settingKey | split(':') | last %}
    {% set isEventSetting = settingName ends with eventSettingSuffix %}
    {% set eventName = settingName | slice(0, settingName | length - eventSettingSuffix | length) %}
    {# The stored value arrives as the string 'true'/'false'. Compared strictly, because 'false' == true in PHP. #}
    {% set isEventEnabled = settingValue is same as(true) or settingValue is same as('true') %}

    {% if isEventSetting %}
        {% set enabledEvents = enabledEvents | merge({ (eventName): isEventEnabled }) %}
    {% endif %}
{% endfor %}

{# The query parameters a project keeps in the page URLs besides the campaign ones, from GoogleAnalyticsConfig; none while GoogleAnalyticsWidget is not registered. #}
{% set additionalPageUrlQueryParameters = findWidget('GoogleAnalyticsWidget').parameters.additionalPageUrlQueryParameters ?? [] %}

{% define attributes = {
    initial: shouldRender
        ? {
            appId: data.gtagId,
            store: app.store,
            locale: app.locale,
            events: enabledEvents,
        } | json_encode
        : {},
    'traceable-adapter': true,
    'data-gtag-script-src': "https://www.googletagmanager.com/gtag/js?id=#{data.gtagId}",
    'price-precision': constant('Spryker\\Shared\\Money\\Converter\\IntegerToDecimalConverter::PRICE_PRECISION'),
    'page-url-query-parameters': additionalPageUrlQueryParameters | json_encode,
} %}

{#
    price-precision - storefront prices are integers of this many parts per currency unit, as Money stores them.
    page-url-query-parameters - JSON list of the query parameters kept in the page URLs besides the campaign ones.
#}

{% block component %}
    {% if shouldRender %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block body %}
    {% include molecule('script-loader') with {
        attributes: {
            'async': true,
            'src': attributes['data-gtag-script-src'],
        },
    } only %}
{% endblock %}
