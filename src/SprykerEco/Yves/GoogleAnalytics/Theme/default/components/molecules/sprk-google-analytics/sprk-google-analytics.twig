{% extends model('component') %}

{% define config = {
    name: 'sprk-google-analytics',
    tag: 'sprk-google-analytics',
} %}

{% define data = {
    gtagId: null,
} %}

{% define attributes = {
    'data-gtag-script-src': "https://www.googletagmanager.com/gtag/js?id=#{data.gtagId}",
    'data-store': app.store | default,
    'data-locale': app.locale | default,
} %}

{% block component %}
    {% if data.gtagId %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block body %}
    {% include molecule('script-loader') with {
        attributes: {
            'src': attributes['data-gtag-script-src'],
        },
    } only %}
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', data.gtagId);
    </script>
{% endblock %}
