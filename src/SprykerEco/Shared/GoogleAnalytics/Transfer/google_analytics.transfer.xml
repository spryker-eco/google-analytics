<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="GoogleAnalyticsEvent" strict="true">
        <property name="searchTerm" type="string"/>
        <property name="count" type="int"/>
        <property name="lastOccurredAt" type="string"/>
        <property name="store" type="string"/>
        <property name="locale" type="string"/>
    </transfer>

    <transfer name="GoogleAnalyticsEventConditions" strict="true">
        <property name="eventName" type="string"/>
        <property name="startDate" type="string"/>
        <property name="endDate" type="string"/>
        <property name="minimumCount" type="int"/>
        <property name="withLastOccurred" type="bool"/>
        <property name="searchTerm" type="string"/>
        <property name="store" type="string"/>
        <property name="locale" type="string"/>
    </transfer>

    <transfer name="Pagination">
        <property name="limit" type="int"/>
        <property name="offset" type="int"/>
        <property name="nbResults" type="int"/>
        <property name="maxPerPage" type="int"/>
        <property name="page" type="int"/>
        <property name="firstIndex" type="int"/>
        <property name="lastIndex" type="int"/>
        <property name="firstPage" type="int"/>
        <property name="lastPage" type="int"/>
        <property name="nextPage" type="int"/>
        <property name="previousPage" type="int"/>
    </transfer>

    <transfer name="Sort">
        <property name="field" type="string"/>
        <property name="isAscending" type="bool"/>
    </transfer>

    <transfer name="GoogleAnalyticsEventCriteria" strict="true">
        <property name="conditions" type="GoogleAnalyticsEventConditions"/>
        <property name="pagination" type="Pagination"/>
        <property name="sortCollection" type="Sort[]" singular="sort"/>
    </transfer>

    <transfer name="GoogleAnalyticsEventCollection" strict="true">
        <property name="events" type="GoogleAnalyticsEvent[]" singular="event"/>
        <property name="pagination" type="Pagination"/>
        <property name="errors" type="Error[]" singular="error"/>
    </transfer>

    <transfer name="Error">
        <property name="message" type="string"/>
    </transfer>

</transfers>
