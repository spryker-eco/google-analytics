{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'Search Terms' | trans %}

{% block head_title widget_title %}
{% block section_title widget_title %}

{% block action %}
    {{ backActionButton(url('/google-analytics/search-statistics'), 'Back to Statistics Dashboard' | trans) }}
{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' %}
        {% block widget_title -%}
            <h5>{{ 'All Search Terms' | trans }}</h5>
        {%- endblock %}

        {% block widget_content %}
            {% include '@GoogleAnalytics/_partials/_form.twig' with { form: form } only %}

            {{ table | raw }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block footer_js %}
    {{ parent() }}
    <script src="{{ assetsPath('js/google-analytics.js') }}"></script>
{% endblock %}
